# 이 파일을 .env로 복사해서 값을 채운다.
#   cp .env.example .env
# app/config.py가 load_dotenv(override=True)를 부르므로
# .env가 기존 셸 환경변수를 덮어쓴다.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qode
OPENAI_API_KEY=sk-...

# 유사도 하한. app/retrieval/filter.py의 코드 기본값과 같은 0.1이다.
# 한국어 질문 ↔ 코드는 코사인 0.3~0.6대라 종전 기본값 0.7은 대부분 걸러냈다.
# 하이브리드 검색 도입 후로는 BM25가 끌어올린 청크도 코사인이 낮아
# 0.7이면 통째로 잘린다 — metadata.score에는 코사인이 그대로 남기 때문.
# 0.1은 필터를 사실상 끈 값이다. score 분포를 재기 전까지의 임시값 (열린 과제 13-15).
SCORE_THRESHOLD=0.1

# local | production
APP_ENV=local

# 동기화된 레포가 클론되는 루트. {루트}/{project_id}/current 를 읽는다.
# 절대 경로이므로 레포를 옮기면 여기도 같이 고쳐야 한다 (안 고치면 옛 위치에 조용히 쌓인다).
LOCAL_REPO_STORAGE_ROOT=./.data/repos
PROD_REPO_STORAGE_ROOT=/var/lib/qode/repos
