# 이 파일을 .env로 복사해서 값을 채운다.
#   cp .env.example .env
# app/config.py가 load_dotenv(override=True)를 부르므로
# .env가 기존 셸 환경변수를 덮어쓴다.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qode
OPENAI_API_KEY=sk-...

# 유사도 하한. app/retrieval/filter.py의 코드 기본값과 같은 0.1이다.
# 한국어 질문 ↔ 코드는 코사인 0.3~0.6대라 종전 기본값 0.7은 대부분 걸러냈다.
# 하이브리드 검색 도입 후로는 BM25가 끌어올린 청크도 코사인이 낮아
# 0.7이면 통째로 잘린다 — metadata.score에는 코사인이 그대로 남기 때문.
# 0.1은 필터를 사실상 끈 값이다. score 분포를 재기 전까지의 임시값 (열린 과제 13-15).
SCORE_THRESHOLD=0.1

# 검색 질의를 영어로 번역하는 Google Cloud Translation (app/retrieval/translate.py).
# 둘 다 필수다 — GOOGLE_TRANSLATE_PROJECT_ID 가 없으면 import 시점에 KeyError 로 서버가 죽는다.
# 키 파일은 서비스 계정 JSON. key.json 은 gitignore 대상이다.
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./key.json

# 리랭크용 Cohere API 키. app/retrieval/reranker.py 가 CohereRerank 로 재정렬한다.
# 코드가 os.getenv 로 직접 읽지 않는다 — langchain_cohere 가 이 이름을 스스로 찾는다.
# 없으면 rerank() 의 except 로 빠져 조용히 벡터 점수 폴백으로 돌아간다. 에러가 아니라
# 로그 한 줄만 남으므로, 리랭크가 켜진 줄 알고 효과를 재면 틀린 결론이 나온다.
COHERE_API_KEY=

# 리랭크 on/off. app/retrieval/reranker.py:8 의 코드 기본값은 true 다.
# false 면 벡터 점수 정렬만 한다 — 켠/끈 비교(열린 과제 13-3)를 이 값으로 돌린다.
RERANKER_ENABLED=true

# local | production
APP_ENV=local

# 동기화된 레포가 클론되는 루트. {루트}/{project_id}/current 를 읽는다.
# 절대 경로이므로 레포를 옮기면 여기도 같이 고쳐야 한다 (안 고치면 옛 위치에 조용히 쌓인다).
LOCAL_REPO_STORAGE_ROOT=./.data/repos
PROD_REPO_STORAGE_ROOT=/var/lib/qode/repos
